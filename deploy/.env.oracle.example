# ---- Oracle Cloud VM backend (copy to .env.oracle and fill in; never commit the real file) ----
ENVIRONMENT=production
HOSPITAL_NAME=Saran Ashram Dispensary
TIMEZONE=Asia/Kolkata

# Public HTTPS name for the API. Free option: your VM's public IP with dashes + .sslip.io
# e.g. public IP 140.238.12.34  ->  140-238-12-34.sslip.io
API_DOMAIN=

# Neon connection string. NOTE the "+psycopg" after "postgresql":
# postgresql+psycopg://user:pass@ep-xyz.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# openssl rand -hex 32   (reuse the values you had on Render so existing logins keep working)
JWT_SECRET=
SYNC_SHARED_SECRET=

ACCESS_TOKEN_MINUTES=15
SESSION_HOURS=8
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
DEV_EXPOSE_OTP=false
