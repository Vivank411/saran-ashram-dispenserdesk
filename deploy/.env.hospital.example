# ---- Hospital server (copy to .env.hospital and fill in; never commit the real file) ----
ENVIRONMENT=production
HOSPITAL_NAME=City Hospital Dispensary
TIMEZONE=Asia/Kolkata
SERVER_NAME=dispensary.hospital.lan

POSTGRES_DB=dispensary
POSTGRES_USER=dispensary
POSTGRES_PASSWORD=change-me-long-random

# openssl rand -hex 32   (different value on each server)
JWT_SECRET=
# openssl rand -hex 32   (SAME value on hospital and cloud)
SYNC_SHARED_SECRET=

# WireGuard: this server's tunnel address, and the cloud API reached through the tunnel
WG_ADDRESS=10.8.0.2
PEER_API_URL=http://10.8.0.1:8000
PEER_TIMEOUT_SECONDS=5
SYNC_INTERVAL_SECONDS=5

ACCESS_TOKEN_MINUTES=15
SESSION_HOURS=10
COOKIE_SECURE=true
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15
LOW_STOCK_THRESHOLD_DEFAULT=50

# Backups
BACKUP_DIR=/srv/dispensary-backups
BACKUP_SCHEDULE=0 2 * * *
RESTORE_TEST_SCHEDULE=30 3 * * 0
BACKUP_RETENTION_DAYS=30
OFFSITE_RSYNC_TARGET=
