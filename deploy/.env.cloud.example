# ---- Cloud server (copy to .env.cloud and fill in; never commit the real file) ----
ENVIRONMENT=production
HOSPITAL_NAME=City Hospital Dispensary
TIMEZONE=Asia/Kolkata
SERVER_NAME=dispensary.example-hospital.in
TLS_CERT_DIR=/etc/letsencrypt/live/dispensary.example-hospital.in

POSTGRES_DB=dispensary
POSTGRES_USER=dispensary
POSTGRES_PASSWORD=change-me-long-random

# openssl rand -hex 32   (different value on each server)
JWT_SECRET=
# openssl rand -hex 32   (SAME value on hospital and cloud)
SYNC_SHARED_SECRET=

# WireGuard: this server's tunnel address, and the hospital API reached through the tunnel
WG_ADDRESS=10.8.0.1
PEER_API_URL=http://10.8.0.2:8000
PEER_TIMEOUT_SECONDS=5

ACCESS_TOKEN_MINUTES=15
SESSION_HOURS=8
LOGIN_MAX_FAILURES=5
LOCKOUT_MINUTES=15

# OTP via SMS gateway (webhook receives JSON {"to","message"} with a Bearer token)
SMS_PROVIDER=webhook
SMS_WEBHOOK_URL=https://sms-gateway.example/send
SMS_WEBHOOK_TOKEN=
OTP_TTL_SECONDS=300
OTP_MAX_SENDS=3
OTP_WINDOW_MINUTES=10
OTP_MAX_ATTEMPTS=3
DEV_EXPOSE_OTP=false

# Backups
BACKUP_DIR=/srv/dispensary-backups
BACKUP_SCHEDULE=30 2 * * *
RESTORE_TEST_SCHEDULE=0 4 * * 0
BACKUP_RETENTION_DAYS=30
OFFSITE_RSYNC_TARGET=
